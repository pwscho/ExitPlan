<Window x:Class="ExitPlan.UI.Views.RmdSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RMD Settings"
        Height="900"
        Width="820"
        MinWidth="680"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="RMD TABLE"
                               Style="{StaticResource SubSectionHeader}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Choose an RMD year file, edit birth-year start ages and the Uniform Lifetime table, then save. The engine still loads RMD{year}.json by scenario base year (exact year, or the closest prior year)."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RMD file"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,8,0"/>
                        <ComboBox Width="260"
                                  ItemsSource="{Binding AvailableFiles}"
                                  SelectedItem="{Binding SelectedFile}"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="Available RMD{year}.json files. The highest year is selected by default."/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="Reload"
                            Style="{StaticResource ButtonOutlined}"
                            Margin="0,0,8,0"
                            Command="{Binding ReloadCommand}"/>
                    <Button Content="Save"
                            Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Save As…"
                            Style="{StaticResource ButtonOutlined}"
                            Margin="0,0,8,0"
                            Command="{Binding SaveAsCommand}"/>
                    <Button Content="Advanced / view JSON"
                            Style="{StaticResource ButtonText}"
                            Command="{Binding ViewJsonCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="  • Unsaved changes"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <TextBlock Text="{Binding RmdDataFolder}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,0"/>
                <TextBlock Text="{Binding ValidationMessage}"
                           FontSize="12"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <DockPanel Margin="20,16">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="RMD start age fallback (years)"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Width="120"
                         HorizontalAlignment="Left"
                         Text="{Binding RmdStartAge, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Used when no birth-year band matches the owner. The engine skips RMDs before the resolved start age."
                         Margin="0,0,0,16"/>

                <TextBlock Text="Birth-year start ages"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Closed bands: Born from and Born through are inclusive. Leave Born through blank only on the last band (no end year). First matching band wins. If none match, the fallback start age above is used. Birth year is scenario base year minus that owner's current age."
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <DataGrid ItemsSource="{Binding StartAgeBands}"
                          SelectedItem="{Binding SelectedBand, Mode=TwoWay}"
                          Height="150"
                          Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Born from"
                                            Width="140"
                                            Binding="{Binding BornFrom, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Born through"
                                            Width="140"
                                            Binding="{Binding BornThroughText, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Start age"
                                            Width="*"
                                            Binding="{Binding StartAge, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Add band"
                            Style="{StaticResource ButtonText}"
                            Command="{Binding AddBandCommand}"/>
                    <Button Content="Remove selected band"
                            Style="{StaticResource ButtonDanger}"
                            Command="{Binding RemoveBandCommand}"/>
                </StackPanel>

                <TextBlock Text="Uniform Lifetime table"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Each row is an age and the IRS distribution period (years). The engine divides the start-of-year tax-deferred balance by that period. Periods are not percentages."
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        Margin="0,8,0,0">
                <Button Content="Add age"
                        Style="{StaticResource ButtonText}"
                        Command="{Binding AddRowCommand}"/>
                <Button Content="Remove selected"
                        Style="{StaticResource ButtonDanger}"
                        Command="{Binding RemoveRowCommand}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Divisors}"
                      SelectedItem="{Binding SelectedDivisor, Mode=TwoWay}"
                      Margin="0,0,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Age (years)"
                                        Width="160"
                                        Binding="{Binding Age, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Distribution period (years)"
                                        Width="*"
                                        Binding="{Binding DistributionPeriod, UpdateSourceTrigger=PropertyChanged}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
