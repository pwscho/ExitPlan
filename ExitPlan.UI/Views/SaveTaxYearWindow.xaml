<Window x:Class="ExitPlan.UI.Views.SaveTaxYearWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save as new year"
        Height="280"
        Width="440"
        MinWidth="400"
        MinHeight="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource ButtonOutlined}"
                    IsCancel="True"
                    Margin="0,0,8,0"/>
            <Button Content="Save"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Create a new Tax{year}.json from the current settings."
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,6"/>
            <TextBlock Text="Enter a 4-digit year only (2000–2100). The filename is fixed and existing years cannot be overwritten."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Year"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="YearBox"
                     Width="120"
                     HorizontalAlignment="Left"
                     MaxLength="4"
                     Text="{Binding YearText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="4-digit tax year used to name Tax{year}.json."
                     PreviewTextInput="YearBox_PreviewTextInput"
                     DataObject.Pasting="YearBox_Pasting"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Filename"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding FileNamePreview, Mode=OneWay}"
                     IsReadOnly="True"
                     IsTabStop="False"
                     Focusable="False"
                     ToolTip="Locked. Save As always writes Tax{year}.json in the tax data folder."/>

            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="12"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
    </DockPanel>
</Window>
