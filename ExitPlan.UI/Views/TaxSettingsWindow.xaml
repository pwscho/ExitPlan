<Window x:Class="ExitPlan.UI.Views.TaxSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ExitPlan.UI.Views"
        Title="Tax Settings"
        Height="860"
        Width="980"
        MinWidth="820"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="TAX POLICY"
                               Style="{StaticResource SubSectionHeader}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Choose a tax year file, edit the tables, then save. Save as new year… copies the current settings to Tax{year}.json. The engine still loads those files the same way as before."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tax file"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,8,0"/>
                        <ComboBox Width="260"
                                  ItemsSource="{Binding AvailableFiles}"
                                  SelectedItem="{Binding SelectedFile}"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="Available Tax{year}.json files. The highest year is selected by default."/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="Reload"
                            Style="{StaticResource ButtonOutlined}"
                            Margin="0,0,8,0"
                            Command="{Binding ReloadCommand}"/>
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Save as new year…"
                            Style="{StaticResource ButtonOutlined}"
                            Margin="8,0,0,0"
                            Command="{Binding SaveAsCommand}"
                            ToolTip="Copy the current settings to Tax{year}.json for a new year. Existing years are not overwritten."/>
                    <Button Content="Advanced / view JSON"
                            Style="{StaticResource ButtonText}"
                            Margin="8,0,0,0"
                            Command="{Binding ViewJsonCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="  • Unsaved changes"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <TextBlock Text="{Binding TaxDataFolder}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,0"/>
                <TextBlock Text="{Binding ValidationMessage}"
                           FontSize="12"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
            <StackPanel>

                <TextBlock Text="Policy year stored in this file"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox Width="120"
                         HorizontalAlignment="Left"
                         Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Year written inside the JSON. The engine selects a file by Tax{year}.json name, then reads this document."
                         Margin="0,0,0,16"/>

                <TextBlock Text="Additional standard deduction age"
                           Style="{StaticResource FieldLabel}"/>
                <TextBlock Text="IRC §63(f). Living owners this age or older add the extra amount on each filing-status tab. Married filing jointly adds that tab's amount per qualifying spouse."
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>
                <TextBox Width="120"
                         HorizontalAlignment="Left"
                         Text="{Binding AdditionalStandardDeductionAge, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Minimum integer age for the additional standard deduction (IRC §63(f)). Typically 65. Shared by Single and Married filing jointly."
                         Margin="0,0,0,16"/>

                <TabControl>
                    <TabItem Header="Single">
                        <views:FilingStatusTaxTableView DataContext="{Binding Single}" Margin="0,8,0,0"/>
                    </TabItem>
                    <TabItem Header="Married filing jointly">
                        <views:FilingStatusTaxTableView DataContext="{Binding MarriedFilingJointly}" Margin="0,8,0,0"/>
                    </TabItem>
                </TabControl>

                <TextBlock Text="Social Security taxation thresholds"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,20,0,8"/>
                <TextBlock Text="Provisional-income thresholds that determine how much Social Security is taxable. Amounts are in dollars. These thresholds are fixed by law and are not inflation-indexed."
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Single first threshold ($)"
                               VerticalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding SingleSsBaseThreshold, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8"
                             ToolTip="First Social Security taxation threshold for single filers."/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Single second threshold ($)"
                               VerticalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding SingleSsSecondThreshold, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8"
                             ToolTip="Second Social Security taxation threshold for single filers."/>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Married first threshold ($)"
                               VerticalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding MarriedSsBaseThreshold, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8"
                             ToolTip="First Social Security taxation threshold for married filing jointly."/>

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="Married second threshold ($)"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding MarriedSsSecondThreshold, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Second Social Security taxation threshold for married filing jointly."/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
