<Window x:Class="ExitPlan.UI.Views.MarketDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ExitPlan.UI.Converters"
        Title="Market Data"
        Height="780"
        Width="920"
        MinWidth="740"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <converters:DecimalToPercentConverter x:Key="PercentConverter"/>
    </Window.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="HISTORICAL MARKET RETURNS"
                               Style="{StaticResource SubSectionHeader}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="The engine always loads MarketData/MarketData.json. Each row is one calendar year of equity return, bond return, and inflation. Values are stored as decimals (0.07 = 7%) and shown here as percents. Negative values are allowed (losses / deflation)."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Content="Reload"
                            Style="{StaticResource ButtonOutlined}"
                            Margin="0,0,8,0"
                            Command="{Binding ReloadCommand}"/>
                    <Button Content="Save"
                            Margin="0,0,8,0"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Advanced / view JSON"
                            Style="{StaticResource ButtonText}"
                            Command="{Binding ViewJsonCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="  • Unsaved changes"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <TextBlock Text="{Binding MarketDataPath}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,0"/>
                <TextBlock Text="{Binding ValidationMessage}"
                           FontSize="12"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <DockPanel Margin="20,16">
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        Margin="0,8,0,0">
                <Button Content="Add year"
                        Style="{StaticResource ButtonText}"
                        Command="{Binding AddYearCommand}"/>
                <Button Content="Remove selected"
                        Style="{StaticResource ButtonDanger}"
                        Command="{Binding RemoveYearCommand}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Years}"
                      SelectedItem="{Binding SelectedYear, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Year"
                                        Width="100"
                                        Binding="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Equity return (%)"
                                        Width="*"
                                        Binding="{Binding EquityReturn, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PercentConverter}}"/>
                    <DataGridTextColumn Header="Bond return (%)"
                                        Width="*"
                                        Binding="{Binding BondReturn, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PercentConverter}}"/>
                    <DataGridTextColumn Header="Inflation (%)"
                                        Width="*"
                                        Binding="{Binding InflationRate, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource PercentConverter}}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
