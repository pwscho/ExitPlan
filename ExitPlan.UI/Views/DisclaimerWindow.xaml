<Window x:Class="ExitPlan.UI.Views.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ExitPlan.Core;assembly=ExitPlan.Core"
        Title="{x:Static core:ProductInfo.SplashTitle}"
        Icon="/Assets/ExitPlan.ico"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,16">
            <Button Content="Continue"
                    Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right"
                    MinWidth="128"
                    IsDefault="True"
                    Click="Continue_Click"/>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}">
            <StackPanel>
                <Grid Margin="28,22,28,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Border Background="#26FFFFFF" CornerRadius="10"/>
                        <Canvas Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Stroke="{StaticResource TextOnPrimaryBrush}"
                                  StrokeThickness="1.6"
                                  Opacity="0.55"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M2,26 L30,26"/>
                            <Path Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M2,22 L11,22 L17,13 L28,8"/>
                            <Ellipse Width="5.5" Height="5.5"
                                     Fill="{StaticResource AccentBrush}"
                                     Canvas.Left="25.5" Canvas.Top="5"/>
                        </Canvas>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static core:ProductInfo.Name}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextOnPrimaryBrush}"/>
                        <TextBlock Text="Household retirement planning"
                                   Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="#D6E4F0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Version "
                                       FontSize="12"
                                       Foreground="#D6E4F0"/>
                            <TextBlock Text="{x:Static core:ProductInfo.Version}"
                                       FontSize="12"
                                       Foreground="#D6E4F0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Border Height="3" Background="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="28,22,28,22">
            <TextBlock Text="{x:Static core:ProductInfo.SplashTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,14"/>
            <TextBlock Text="{x:Static core:ProductInfo.SplashLead}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,12"/>
            <TextBlock Text="{x:Static core:ProductInfo.SplashLimits}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,12"/>
            <TextBlock Text="{x:Static core:ProductInfo.SplashAcknowledgement}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
    </DockPanel>
</Window>
