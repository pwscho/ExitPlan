<Window x:Class="ExitPlan.UI.Views.RmdSaveAsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save RMD table as…"
        Height="280"
        Width="460"
        MinWidth="420"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <DockPanel Margin="20,16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource ButtonOutlined}"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button x:Name="CreateButton"
                    Content="Create"
                    IsDefault="True"
                    Click="Create_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="The engine loads RMD{year}.json, so the file name is fixed from the year you enter. Existing years cannot be overwritten."
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Year"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="YearBox"
                     Width="140"
                     HorizontalAlignment="Left"
                     TextChanged="YearBox_TextChanged"
                     Margin="0,0,0,12"/>

            <TextBlock Text="File name"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="FileNamePreview"
                     IsReadOnly="True"
                     IsTabStop="False"
                     Width="220"
                     HorizontalAlignment="Left"
                     Margin="0,0,0,12"/>

            <TextBlock x:Name="ErrorText"
                       FontSize="12"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>
