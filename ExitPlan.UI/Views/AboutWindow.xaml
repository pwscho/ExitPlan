<Window x:Class="ExitPlan.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About ExitPlan"
        Icon="/Assets/ExitPlan.ico"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <Button Content="OK"
                    Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right"
                    MinWidth="96"
                    IsDefault="True"
                    IsCancel="True"/>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}">
            <StackPanel>
                <Grid Margin="24,20,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="56" Height="56" Margin="0,0,16,0"
                            Background="#26FFFFFF" CornerRadius="10">
                        <Image Source="/Assets/ExitPlan.ico"
                               Width="36" Height="36"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppName, Mode=OneWay}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextOnPrimaryBrush}"/>
                        <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="#D6E4F0">
                            <Run Text="Version "/>
                            <Run Text="{Binding Version, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <Border Height="3" Background="{StaticResource AccentBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel Margin="24,18,24,8">
                <TextBlock FontSize="13" Margin="0,0,0,4"
                           Foreground="{StaticResource TextPrimaryBrush}">
                    <Run Text="Publisher: "/>
                    <Run Text="{Binding Publisher, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Copyright, Mode=OneWay}"
                           FontSize="13"
                           Margin="0,0,0,8"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}">
                    <Run Text="License: "/>
                    <Hyperlink NavigateUri="https://polyformproject.org/licenses/noncommercial/1.0.0/"
                               RequestNavigate="Link_RequestNavigate"
                               Foreground="{StaticResource PrimaryBrush}">
                        PolyForm Noncommercial 1.0.0
                    </Hyperlink>
                </TextBlock>
                <Button Content="Show LICENSE.md"
                        Style="{StaticResource ButtonText}"
                        HorizontalAlignment="Left"
                        Padding="0,4"
                        Margin="0,2,0,8"
                        Visibility="{Binding HasLicenseFile, Converter={StaticResource BoolToVisibility}}"
                        Click="ShowLicense_Click"/>

                <TextBlock FontSize="13" Margin="0,4,0,4"
                           Foreground="{StaticResource TextPrimaryBrush}">
                    <Run Text="Project: "/>
                    <Hyperlink NavigateUri="https://github.com/pwscho/ExitPlan"
                               RequestNavigate="Link_RequestNavigate"
                               Foreground="{StaticResource PrimaryBrush}">
                        https://github.com/pwscho/ExitPlan
                    </Hyperlink>
                </TextBlock>
                <TextBlock FontSize="13" Margin="0,0,0,4"
                           Foreground="{StaticResource TextPrimaryBrush}">
                    <Run Text="Releases: "/>
                    <Hyperlink NavigateUri="https://github.com/pwscho/ExitPlan/releases"
                               RequestNavigate="Link_RequestNavigate"
                               Foreground="{StaticResource PrimaryBrush}">
                        https://github.com/pwscho/ExitPlan/releases
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="DATA FOLDER"
                           Style="{StaticResource SubSectionHeader}"
                           Margin="0,16,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding ActiveDataFolder, Mode=OneWay}"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             TextWrapping="Wrap"
                             Background="{StaticResource SidebarBrush}"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1"
                            Content="Copy"
                            Style="{StaticResource ButtonOutlined}"
                            VerticalAlignment="Top"
                            Click="CopyDataFolder_Click"/>
                </Grid>

                <TextBlock Text="APPSTATE.JSON"
                           Style="{StaticResource SubSectionHeader}"
                           Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding AppStatePath, Mode=OneWay}"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             TextWrapping="Wrap"
                             Background="{StaticResource SidebarBrush}"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1"
                            Content="Copy"
                            Style="{StaticResource ButtonOutlined}"
                            VerticalAlignment="Top"
                            Click="CopyAppState_Click"/>
                </Grid>

                <TextBlock Margin="0,16,0,4" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}">
                    <Run Text="Update channel: " FontWeight="SemiBold"/>
                    <Run Text="{Binding UpdateChannel, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="13" Foreground="{StaticResource TextPrimaryBrush}">
                    <Run Text="Update status: " FontWeight="SemiBold"/>
                    <Run Text="{Binding UpdateStatus, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Text="{Binding Disclaimer, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,8"
                           FontSize="12"
                           LineHeight="18"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
