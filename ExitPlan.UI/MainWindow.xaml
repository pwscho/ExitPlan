<Window x:Class="ExitPlan.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ExitPlan.UI.Views"
        xmlns:core="clr-namespace:ExitPlan.Core;assembly=ExitPlan.Core"
        Title="{Binding WindowTitle}" Height="700" Width="1100"
        Icon="/Assets/ExitPlan.ico"
        MinWidth="900" MinHeight="550"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <DockPanel>

        <Menu DockPanel.Dock="Top"
              Background="{StaticResource SurfaceBrush}"
              FontSize="13">
            <MenuItem Header="_File">
                <MenuItem Header="Open AppState.json..."
                          Click="OpenAppState_Click"/>
                <MenuItem Header="Choose Data Folder..."
                          Click="ChooseDataFolder_Click"/>
                <Separator/>
                <MenuItem Header="Open Data Folder"
                          Click="OpenDataFolder_Click"/>
                <MenuItem Header="Reset to Default Folder"
                          Click="ResetDataFolder_Click"/>
            </MenuItem>
        </Menu>

        <Button DockPanel.Dock="Bottom"
                Click="OpenDataFolder_Click"
                HorizontalContentAlignment="Stretch"
                Cursor="Hand"
                ToolTip="Open this folder in Explorer"
                AutomationProperties.Name="Open data folder"
                Background="{StaticResource HighlightBrush}"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="0,2,0,0"
                Padding="12,8">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <TextBlock TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{StaticResource TextPrimaryBrush}">
                <Run Text="Data folder: " FontWeight="SemiBold"/>
                <Run Text="{Binding ActiveDataFolder, Mode=OneWay}"
                     Foreground="{StaticResource PrimaryBrush}"
                     TextDecorations="Underline"/>
                <Run Text="   (click to open in Explorer)"
                     FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}"/>
                <LineBreak/>
                <Run Text="AppState.json: " FontWeight="SemiBold"/>
                <Run Text="{Binding AppStatePath, Mode=OneWay}"
                     Foreground="{StaticResource PrimaryBrush}"
                     TextDecorations="Underline"/>
            </TextBlock>
        </Button>

        <!-- Left Sidebar: Scenario Manager -->
        <Border DockPanel.Dock="Left"
                Width="240"
                Background="{StaticResource SidebarBrush}"
                Padding="16"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,1,0">

            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Line Style="{StaticResource Divider}"/>
                    <TextBlock Text="{x:Static core:ProductInfo.Title}"
                               Margin="0,12,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Retirement simulator"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{x:Static core:ProductInfo.ModelNotice}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="SCENARIOS"
                                   Style="{StaticResource SubSectionHeader}"
                                   Margin="0 0 0 12"/>

                        <ListBox ItemsSource="{Binding ScenarioManager.Scenarios}"
                                 SelectedItem="{Binding ScenarioManager.SelectedScenario}"
                                 Margin="0 0 0 12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Stretch"
                                    Margin="0 0 0 12">
                            <Button Content="Add"
                                    Style="{StaticResource ButtonText}"
                                    Margin="0 0 4 0"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding ScenarioManager.AddScenarioCommand}" />

                            <Button Content="Copy"
                                    Style="{StaticResource ButtonText}"
                                    Margin="0 0 4 0"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding ScenarioManager.DuplicateScenarioCommand}" />

                            <Button Content="Delete"
                                    Style="{StaticResource ButtonDanger}"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding ScenarioManager.DeleteScenarioCommand}" />
                        </StackPanel>

                        <Line Style="{StaticResource Divider}"/>

                        <Button Content="Tax Settings"
                                Style="{StaticResource ButtonOutlined}"
                                Padding="10,8"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Click="OpenTaxSettings_Click"/>

                        <Button Content="RMD Settings"
                                Style="{StaticResource ButtonOutlined}"
                                Padding="10,8"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Click="OpenRmdSettings_Click"/>

                        <Button Content="Market Data"
                                Style="{StaticResource ButtonOutlined}"
                                Padding="10,8"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Click="OpenMarketData_Click"/>

                        <Button Content="Check for updates"
                                Style="{StaticResource ButtonOutlined}"
                                Padding="10,8"
                                HorizontalAlignment="Stretch"
                                Click="CheckForUpdates_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <TabControl>

            <TabItem Header="Scenario">
                <views:ScenarioView DataContext="{Binding ScenarioVM}"/>
            </TabItem>

            <TabItem Header="Social Security">
                <views:SocialSecurityView DataContext="{Binding SocialSecurityVM}"/>
            </TabItem>

            <TabItem Header="Accounts">
                <views:AccountsView DataContext="{Binding AccountsVM}"/>
            </TabItem>

            <TabItem Header="Income">
                <views:IncomeView DataContext="{Binding IncomeVM}"/>
            </TabItem>

            <TabItem Header="Withdrawals">
                <views:WithdrawalsView DataContext="{Binding WithdrawalsVM}" />
            </TabItem>

            <TabItem Header="Roth Conversions">
                <views:RothConversionView DataContext="{Binding RothConversionVM}"/>
            </TabItem>

            <TabItem Header="Results">
                <views:ResultsView/>
            </TabItem>

        </TabControl>

    </DockPanel>

</Window>
