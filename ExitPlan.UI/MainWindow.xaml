<Window x:Class="ExitPlan.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ExitPlan.UI.Views"
        xmlns:core="clr-namespace:ExitPlan.Core;assembly=ExitPlan.Core"
        Title="{Binding WindowTitle}" Height="700" Width="1100"
        Icon="/Assets/ExitPlan.ico"
        MinWidth="900" MinHeight="550"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <DockPanel>

        <Menu DockPanel.Dock="Top"
              Background="{StaticResource SurfaceBrush}"
              FontSize="13">
            <MenuItem Header="_File">
                <MenuItem Header="Add Scenario..."
                          Command="{Binding ScenarioManager.AddScenarioCommand}"/>
                <MenuItem Header="Copy Scenario..."
                          Command="{Binding ScenarioManager.DuplicateScenarioCommand}"/>
                <MenuItem Header="Delete Scenario..."
                          Command="{Binding ScenarioManager.DeleteScenarioCommand}"/>
                <Separator/>
                <MenuItem Header="Close"
                          InputGestureText="Alt+F4"
                          Click="Close_Click"/>
            </MenuItem>
            <MenuItem Header="_Config">
                <MenuItem Header="Tax Settings..."
                          Click="OpenTaxSettings_Click"/>
                <MenuItem Header="RMD Settings..."
                          Click="OpenRmdSettings_Click"/>
                <MenuItem Header="Market Data..."
                          Click="OpenMarketData_Click"/>
                <Separator/>
                <MenuItem Header="Open AppState.json..."
                          Click="OpenAppState_Click"/>
                <MenuItem Header="Choose Data Folder..."
                          Click="ChooseDataFolder_Click"/>
                <Separator/>
                <MenuItem Header="Open Data Folder"
                          Click="OpenDataFolder_Click"/>
                <MenuItem Header="Reset to Default Folder"
                          Click="ResetDataFolder_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for updates"
                          Click="CheckForUpdates_Click"/>
                <Separator/>
                <MenuItem Header="_About ExitPlan..."
                          Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Left Sidebar: Scenario Manager -->
        <Border DockPanel.Dock="Left"
                Width="240"
                Background="{StaticResource SidebarBrush}"
                Padding="16"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,1,0">

            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Line Style="{StaticResource Divider}"/>
                    <TextBlock Text="{x:Static core:ProductInfo.Title}"
                               Margin="0,12,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Retirement simulator"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{x:Static core:ProductInfo.ModelNotice}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="SCENARIOS"
                                   Style="{StaticResource SubSectionHeader}"
                                   Margin="0 0 0 12"/>

                        <ListBox ItemsSource="{Binding ScenarioManager.Scenarios}"
                                 SelectedItem="{Binding ScenarioManager.SelectedScenario}"
                                 Margin="0 0 0 12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Stretch">
                            <Button Content="Add"
                                    Style="{StaticResource ButtonText}"
                                    Margin="0 0 4 0"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding ScenarioManager.AddScenarioCommand}" />

                            <Button Content="Copy"
                                    Style="{StaticResource ButtonText}"
                                    Margin="0 0 4 0"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding ScenarioManager.DuplicateScenarioCommand}" />

                            <Button Content="Delete"
                                    Style="{StaticResource ButtonDanger}"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding ScenarioManager.DeleteScenarioCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <TabControl>

            <TabItem Header="Scenario">
                <views:ScenarioView DataContext="{Binding ScenarioVM}"/>
            </TabItem>

            <TabItem Header="Social Security">
                <views:SocialSecurityView DataContext="{Binding SocialSecurityVM}"/>
            </TabItem>

            <TabItem Header="Accounts">
                <views:AccountsView DataContext="{Binding AccountsVM}"/>
            </TabItem>

            <TabItem Header="Income">
                <views:IncomeView DataContext="{Binding IncomeVM}"/>
            </TabItem>

            <TabItem Header="Withdrawals">
                <views:WithdrawalsView DataContext="{Binding WithdrawalsVM}" />
            </TabItem>

            <TabItem Header="Roth Conversions">
                <views:RothConversionView DataContext="{Binding RothConversionVM}"/>
            </TabItem>

            <TabItem Header="Results">
                <views:ResultsView/>
            </TabItem>

        </TabControl>

    </DockPanel>

</Window>
