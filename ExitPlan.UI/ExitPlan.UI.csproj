<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Only Version is the product version. The SDK sets assembly, file, and
         informational versions from it, and appends +git to the informational
         version (Windows ProductVersion). Do not pin those three properties. -->
    <Version>2.4.3</Version>
    <Product>ExitPlan</Product>
    <ApplicationIcon>Assets\ExitPlan.ico</ApplicationIcon>
    <!-- WPF generates its own Main. Velopack has to run before any WPF startup. -->
    <StartupObject>ExitPlan.UI.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Data\AppState.json" />
    <None Remove="Assets\ExitPlan.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ExitPlan.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\AppState.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\LICENSE.md" Link="LICENSE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExitPlan.Core\ExitPlan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <Folder Include="Utilities\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
